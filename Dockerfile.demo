# syntax=docker/dockerfile:1

# ---- Build Stage ----
FROM node:22-alpine AS base
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apk add --no-cache gcompat
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
RUN pnpm add -g turbo@^2.5.4

FROM base AS builder
COPY . .
RUN turbo prune @uptimekit/dash --docker

FROM base AS installer
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=builder /app/out/full/ .
RUN pnpm exec turbo build --filter=@uptimekit/dash...

# ---- Demo Stage ----
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-15 \
    postgresql-client-15 \
    redis-server \
    curl \
    ca-certificates \
    gnupg \
    && curl -fsSL https://packagecloud.io/timescale/timescaledb/gpgkey | gpg --dearmor -o /usr/share/keyrings/timescaledb.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/timescaledb.gpg] https://packagecloud.io/timescale/timescaledb/debian/ bookworm main" \
        > /etc/apt/sources.list.d/timescaledb.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends timescaledb-2-postgresql-15 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=installer /app/apps/dash/next.config.ts ./

COPY --from=installer /app/packages/db ./packages/db
COPY --from=installer /app/packages/config ./packages/config
COPY --from=installer /app/packages/api ./packages/api
COPY --from=installer /app/packages/auth ./packages/auth

COPY --from=installer /app/apps/dash/.next/standalone ./
COPY --from=installer /app/apps/dash/.next/static ./apps/dash/.next/static
COPY --from=installer /app/apps/dash/public ./apps/dash/public
COPY --from=installer /app/node_modules ./node_modules

COPY --from=builder /app/scripts/seed-db.ts ./scripts/seed-db.ts
COPY --from=builder /app/turbo.json ./turbo.json

COPY docker/demo-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV NODE_ENV=production
ENV NODE_PATH=/app/node_modules
ENV DATABASE_URL=postgres://uptimekit:uptimekit@localhost:5432/uptimekit
ENV TIMESERIES_BACKEND=timescale
ENV REDIS_URL=redis://localhost:6379
ENV APP_SECRET=demo-secret-change-in-production
ENV APP_URL=http://localhost:3000
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV PGDATA=/var/lib/postgresql/data
ENV PGDATABASE=uptimekit
ENV PGUSER=uptimekit
ENV PGPASSWORD=uptimekit
ENV DEMO_MODE=true
ENV DEMO_EMAIL=demo@uptimekit.local
ENV DEMO_PASSWORD=DemoPassword123!

EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
