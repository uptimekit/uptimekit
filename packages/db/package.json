{
    "name": "@uptimekit/db",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "default": "./src/index.ts"
        },
        "./*": {
            "default": "./src/*.ts"
        }
    },
    "scripts": {
        "check-types": "tsc --noEmit -p tsconfig.json",
        "db:push": "tsx src/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/migrate.ts",
        "test": "vitest run"
    },
    "devDependencies": {
        "drizzle-kit": "^0.31.10",
        "testcontainers": "^12.1.0",
        "tsx": "^4.23.9",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@clickhouse/client": "^1.23.1",
        "@uptimekit/config": "workspace:*",
        "dotenv": "catalog:",
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.9",
        "zod": "catalog:"
    }
}
