{
    "name": "@uptimekit/db",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "default": "./src/index.ts"
        },
        "./*": {
            "default": "./src/*.ts"
        }
    },
    "scripts": {
        "check-types": "tsc --noEmit -p tsconfig.json",
        "db:push": "tsx src/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx src/migrate.ts",
        "test": "vitest run",
        "build:migrate": "esbuild src/migrate.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/migrate.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" && rm -rf dist/migrations && cp -r src/migrations dist/migrations"
    },
    "devDependencies": {
        "drizzle-kit": "^0.31.11",
        "esbuild": "^0.28.2",
        "testcontainers": "^12.2.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@clickhouse/client": "^1.24.1",
        "@uptimekit/config": "workspace:*",
        "dotenv": "catalog:",
        "drizzle-orm": "catalog:",
        "postgres": "^3.4.9",
        "zod": "catalog:"
    }
}
