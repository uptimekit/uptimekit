{
    "name": "@uptimekit/api",
    "private": true,
    "exports": {
        ".": {
            "default": "./src/index.ts"
        },
        "./*": {
            "default": "./src/*.ts"
        },
        "./pkg/*": {
            "default": "./src/pkg/*/index.ts"
        },
        "./pkg/integrations/registry": {
            "default": "./src/pkg/integrations/registry.ts"
        },
        "./pkg/integrations/definitions/discord-meta": {
            "default": "./src/pkg/integrations/definitions/discord-meta.ts"
        },
        "./pkg/integrations/definitions/gchat-meta": {
            "default": "./src/pkg/integrations/definitions/gchat-meta.ts"
        },
        "./pkg/integrations/definitions/telegram-meta": {
            "default": "./src/pkg/integrations/definitions/telegram-meta.ts"
        },
        "./pkg/integrations/definitions/webhook-meta": {
            "default": "./src/pkg/integrations/definitions/webhook-meta.ts"
        },
        "./pkg/integrations/definitions/smtp-meta": {
            "default": "./src/pkg/integrations/definitions/smtp-meta.ts"
        },
        "./pkg/integrations/definitions/smtp": {
            "default": "./src/pkg/integrations/definitions/smtp.ts"
        },
        "./pkg/integrations/definitions/alertmanager-meta": {
            "default": "./src/pkg/integrations/definitions/alertmanager-meta.ts"
        },
        "./pkg/integrations/definitions/alertmanager": {
            "default": "./src/pkg/integrations/definitions/alertmanager.ts"
        },
        "./pkg/integrations/definitions/apprise-meta": {
            "default": "./src/pkg/integrations/definitions/apprise-meta.ts"
        },
        "./pkg/integrations/definitions/ntfy-meta": {
            "default": "./src/pkg/integrations/definitions/ntfy-meta.ts"
        }
    },
    "type": "module",
    "scripts": {
        "check-types": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/nodemailer": "^8.0.1",
        "@uptimekit/config": "workspace:*",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "@clickhouse/client": "^1.23.1",
        "@node-rs/argon2": "^2.0.2",
        "@orpc/client": "catalog:",
        "@orpc/openapi": "catalog:",
        "@orpc/server": "catalog:",
        "@orpc/zod": "catalog:",
        "@uptimekit/auth": "workspace:*",
        "@uptimekit/db": "workspace:*",
        "dotenv": "catalog:",
        "drizzle-orm": "catalog:",
        "effect": "^3.22.1",
        "evlog": "^2.24.0",
        "nodemailer": "^9.0.4",
        "semver": "^7.8.5",
        "socket.io-client": "^4.8.3",
        "zod": "catalog:"
    }
}
